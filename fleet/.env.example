# Local development. On Vercel these are set in the project settings.
# Leave DATABASE_URL empty to use the built-in database in .data/.
DATABASE_URL=

# The same values as the root .env. Sign-in always goes through Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Moving vehicles for the demo company in development. Set to false to stop them.
# SIMULATE=false

# Map tile URL for the frontend build. Use a paid provider for production traffic.
VITE_MAP_TILES=
