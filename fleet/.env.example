# Leave DATABASE_URL empty to use the built-in database in .data/.
# For Supabase, use its Postgres connection string.
DATABASE_URL=

# Required when NODE_ENV=production. Use a long random value.
JWT_SECRET=

# Demo company and moving vehicles. On in development, off in production unless set to true.
# SEED_DEMO=true
# SIMULATE=false

# Map tile URL for the frontend build. Use a paid provider for production traffic.
VITE_MAP_TILES=
