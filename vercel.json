{
    "buildCommand": "npm run build",
    "outputDirectory": "www",
    "headers": [
        {
            "source": "/(.*)\\.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*)\\.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, must-revalidate"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/fleet/:path*",
            "destination": "/api/fleet?path=:path*"
        },
        {
            "source": "/fleet",
            "destination": "/fleet/index.html"
        },
        {
            "source": "/fleet/:path*",
            "destination": "/fleet/index.html"
        }
    ]
}
